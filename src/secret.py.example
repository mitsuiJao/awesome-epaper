# cp secret.py.example secret.py し、実際の値を埋める。
# secret.py 自体と、ここで指すOAuthクライアントシークレットJSONは .gitignore 対象。
# 初回認証後に生成される token.json も同様に .gitignore 対象。

# GCPで発行したOAuthクライアントID（種類: TVおよび限定入力機能を持つデバイス）のクライアントシークレットJSONファイル名
GOOGLE_OAUTH_CLIENT_SECRET_FILE = "oauth-client-secret.json"

# 予定を読み取るGoogleカレンダーのカレンダーID
GOOGLE_CALENDAERID = "your-calendar-id@group.calendar.google.com"
